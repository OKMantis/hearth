<div class="max-w-sm mx-auto mt-20 bg-white p-8 rounded-lg shadow">
  <h1 class="text-2xl font-bold mb-6">Sign in to Hearth</h1>

  <%= form_with url: session_path do |f| %>
    <div class="mb-4">
      <%= f.label :email, class: "block text-sm font-medium mb-1" %>
      <%= f.email_field :email, autofocus: true, class: "w-full border rounded px-3 py-2" %>
    </div>
    <div class="mb-6">
      <%= f.label :password, class: "block text-sm font-medium mb-1" %>
      <%= f.password_field :password, class: "w-full border rounded px-3 py-2" %>
    </div>
    <%= f.submit "Sign in", class: "w-full bg-orange-600 text-white py-2 rounded hover:bg-orange-700" %>
  <% end %>
</div>